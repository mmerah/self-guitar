// Open G (D2 G2 D3 G3 B3 D4): open = G, barre 5 = C, barre 7 = D. Bar 4 slides F up to G on string 1.
\title "Open G: barres and a slide"
\tempo 90
\track ("Guitar" "Gtr.") { instrument acousticguitarsteel }
\staff { tabs }
\tuning (D4 B3 G3 D3 G2 D2)
\ts (4 4)
:8 0.5{rf 1} 0.3{rf 2} 0.4{rf 1} 0.2{rf 3} 0.5{rf 1} 0.3{rf 2} 0.4{rf 1} 0.2{rf 3} |
5.5{lf 2 rf 1} 5.3{rf 2} 5.4{rf 1} 5.2{rf 3} 5.5{rf 1} 5.3{rf 2} 5.4{rf 1} 5.2{rf 3} |
7.5{lf 2 rf 1} 7.3{rf 2} 7.4{rf 1} 7.2{rf 3} 7.5{rf 1} 7.3{rf 2} 7.4{rf 1} 7.2{rf 3} |
0.5{rf 1} 3.1{lf 4 sl rf 4} 5.1{lf 4} 0.4{rf 1} :2 (0.5 0.4 0.3 0.2 5.1)
