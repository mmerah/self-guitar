{
	"name": "self-guitar",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "npm run content:build && vite dev",
		"build": "npm run content:build && vite build",
		"preview": "vite preview",
		"start": "node build",
		"content:build": "node --experimental-strip-types scripts/content-build.ts",
		"content:check": "node --experimental-strip-types scripts/content-check.ts",
		"db:generate": "drizzle-kit generate",
		"check": "npm run content:build && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "npm run content:check && npm run content:build && vitest run",
		"test:e2e": "npm run build && playwright test",
		"ci": "npm run lint && npm run check && npm test && npm run test:e2e"
	},
	"dependencies": {
		"better-sqlite3": "^12.11.1",
		"drizzle-orm": "^0.45.4",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@coderline/alphatab": "^1.9.0",
		"@coderline/alphatab-vite": "^1.9.0",
		"@eslint/js": "^9.39.5",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.3.3",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^22.20.5",
		"@vite-pwa/sveltekit": "^1.1.0",
		"drizzle-kit": "^0.31.11",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.14.0",
		"pitchy": "^4.1.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^3.5.2",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svguitar": "^2.10.1",
		"tailwindcss": "^4.3.3",
		"typescript": "~5.9",
		"typescript-eslint": "^8.72.1",
		"vite": "^7.3.7",
		"vitest": "^3.2.7",
		"yaml": "^2.9.1"
	}
}
