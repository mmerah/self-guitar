// Box 1 up, a ring-finger slide on string 3 (7 to 9) into box 2, box 2 over the top strings, and
// the same slide back down (9 to 7) into box 1. A minor pentatonic, 8ths.
\title "Connect boxes 1 and 2 with a slide"
\tempo 100
\track ("Guitar" "Gtr.") { instrument acousticguitarsteel }
