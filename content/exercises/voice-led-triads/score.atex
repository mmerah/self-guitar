// I-vi-IV-V in C with each triad the nearest inversion: few notes move between chords.
// Bars 1-4 strings 3-2-1: C (C E G), Am (C E A), F (C F A), G (B D G).
// Bars 5-8 strings 4-3-2: C (G C E), Am (A C E), F (A C F), G (G B D).
\title "Voice-led triads: C, Am, F, G"
\tempo 80
\track ("Guitar" "Gtr.") { instrument acousticguitarsteel }
\staff { tabs }
\ts (4 4)
:8 5.3{txt "C"} 5.2 3.1 5.2 :2 (5.3 5.2 3.1) |
:8 5.3{txt "Am"} 5.2 5.1 5.2 :2 (5.3 5.2 5.1) |
:8 5.3{txt "F"} 6.2 5.1 6.2 :2 (5.3 6.2 5.1) |
:8 4.3{txt "G"} 3.2 3.1 3.2 :2 (4.3 3.2 3.1) |
:8 5.4{txt "C"} 5.3 5.2 5.3 :2 (5.4 5.3 5.2) |
:8 7.4{txt "Am"} 5.3 5.2 5.3 :2 (7.4 5.3 5.2) |
:8 7.4{txt "F"} 5.3 6.2 5.3 :2 (7.4 5.3 6.2) |
