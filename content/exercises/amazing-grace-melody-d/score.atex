// Amazing Grace (tune "New Britain", 1829), the library melody moved up a fifth from G to D so it
// sits on strings 1-3 (A on string 3, D on string 2, F# and E on string 1). Pickup + bars 1-8.
// Fingers from the D chord shape: index on string 3 fret 2, middle string 1 fret 2, ring string 2 fret 3.
\title "Amazing Grace: the melody on top, in D"
\music "Traditional"
\tempo 80
\track ("Guitar" "Gtr.") { instrument acousticguitarsteel }
\staff { score tabs }
\ts (3 4) \ac
:4 2.3{lf 2} |
:2 3.2{lf 4 ch "D"} :8 2.1{lf 3} 3.2 | :2 2.1 :4 0.1 | :2 3.2{ch "G"} :4 0.2 | :2 2.3{ch "D"} :4 2.3 |
:2 3.2 :8 2.1 3.2 | :2 2.1 :4 0.1 | :2 5.1{lf 5 d ch "A"} | :2 5.1 :4 2.1
