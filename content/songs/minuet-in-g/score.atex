// Minuet in G (BWV Anh. 114, attributed to Christian Petzold), first section, melody only.
// First position: eighth-note runs across strings 1 to 4.
\title "Minuet in G"
\music "Christian Petzold"
\tempo 100
\track ("Melody" "Mel.") { instrument acousticguitarnylon }
