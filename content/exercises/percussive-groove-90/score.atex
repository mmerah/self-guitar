// One bar of groove on four chords, straight 8ths:
// 1 bass + top string | & i | 2 thumb slap | & m | 3 bass | & i | 4 thumb slap | & snap (P) string 3.
\title "Percussive groove: Em, C, G, D"
\tempo 90
\track ("Guitar" "Gtr.") { instrument acousticguitarsteel }
