// One finger per fret: index 1, middle 2, ring 3, pinky 4. Up 1-2-3-4 on each string from low E
// to high e, then back down 4-3-2-1 from high e to low E. Leave each finger down until it is needed again.
\title "Finger warm-up: 1-2-3-4"
\tempo 60
\track ("Guitar" "Gtr.") { instrument acousticguitarsteel }
\staff { tabs }
\ts (4 4)
:8 1.6 2.6 3.6 4.6 1.5 2.5 3.5 4.5 |
:8 1.4 2.4 3.4 4.4 1.3 2.3 3.3 4.3 |
:8 1.2 2.2 3.2 4.2 1.1 2.1 3.1 4.1 |
:8 4.1 3.1 2.1 1.1 4.2 3.2 2.2 1.2 |
:8 4.3 3.3 2.3 1.3 4.4 3.4 2.4 1.4 |
:8 4.5 3.5 2.5 1.5 4.6 3.6 2.6 1.6
