// C major on the top three strings: 2nd inversion (G C E) open, root position (C E G) at 5,
// 1st inversion (E G C) at 8, 2nd inversion again at 12.
\title "C triads up strings 1-3"
\tempo 80
\track ("Guitar" "Gtr.") { instrument acousticguitarsteel }
\staff { tabs }
\ts (4 4)
:8 0.3 1.2{lf 2} 0.1 1.2 :2 (0.3 1.2 0.1) |
:8 5.3{lf 3} 5.2{lf 4} 3.1{lf 2} 5.2 :2 (5.3 5.2 3.1) |
:8 9.3{lf 3} 8.2{lf 2} 8.1{lf 2} 8.2 :2 (9.3 8.2 8.1) |
:8 12.3{lf 2} 13.2{lf 3} 12.1{lf 2} 13.2 :2 (12.3 13.2 12.1)
