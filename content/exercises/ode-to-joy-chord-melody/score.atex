// Ode to Joy (L. van Beethoven, 1824; public domain), first phrase in G, as a chord melody.
// The melody stays on string 1: B B C D | D C B A | G G A B | B. A A. On the main beats a triad on
// strings 1-3 sits under it, with the melody note on top:
// G with B on top 7-8-7 (D G B), D with D on top 11-10-10 (F# A D), G with G on top 4-3-3 (B D G),
// D with A on top 7-7-5 (D F# A).
\title "Ode to Joy: chord melody in G"
\tempo 80
\track ("Guitar" "Gtr.") { instrument acousticguitarsteel }
\staff { tabs }
\ts (4 4)
:4 (7.3{lf 2} 8.2{lf 4} 7.1{lf 3}){ch "G"} 7.1{lf 3} 8.1{lf 4} 10.1{lf 5} |
:4 (11.3{lf 3} 10.2{lf 2} 10.1{lf 2}){ch "D"} 8.1{lf 3} 7.1{lf 2} 5.1{lf 2} |
:4 (4.3{lf 3} 3.2{lf 2} 3.1{lf 2}){ch "G"} 3.1{lf 2} 5.1{lf 4} 7.1{lf 3} |
:4 (7.3{lf 2} 8.2{lf 4} 7.1{lf 3}){ch "G" d} 5.1{lf 2}.8 (7.3{lf 4} 7.2{lf 5} 5.1{lf 2}).2{ch "D"}
