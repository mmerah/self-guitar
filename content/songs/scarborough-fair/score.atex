// Scarborough Fair - traditional English ballad, A dorian, melody with open-string bass on the downbeats.
\title "Scarborough Fair"
\music "Traditional"
\tempo 96
\track ("Guitar" "Gtr.") { instrument acousticguitarsteel }
\staff { score tabs }
\ts (3 4)
\section "Are you going to Scarborough Fair"
:2 (2.3 0.5){ch "Am"} :4 2.3 |
:2 (0.1 0.5) :4 0.1 |
(0.2 0.6){ch "Em" d} 1.2.8 0.2.4 |
:2 (2.3 0.5){ch "Am" d} |
\section "Parsley, sage, rosemary and thyme"
:4 r 0.1 3.1 |
:2 (5.1 0.5){ch "Am"} :4 3.1 |
(0.1 0.5){ch "D"} 2.1 3.2 |
:2 (0.1 0.6){ch "Em" d} |
