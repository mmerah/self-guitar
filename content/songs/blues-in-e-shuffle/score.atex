// 12-bar blues shuffle in E - traditional boogie pattern on the bass strings, played with a swing feel.
// Form: E E E E | A A E E | B7 A E B7, then an ending E7.
// B7 bars stay inside the open B7 shape (x21202): root + 3rd, root + b7, no stretch.
\title "12-Bar Blues Shuffle in E"
\music "Traditional"
\tempo 90
\track ("Guitar" "Gtr.") { instrument acousticguitarsteel }
\staff { score tabs }
\ts (4 4) \tf t8
