// An original 8-bar melody in C, first position, for reading from the staff: quarter, half and whole notes.
// C3 D3 E3 F3 G3 A3 and B2: the notes on and below the treble staff (guitar sounds an octave lower than written).
\title "Read a melody in C from the staff"
\tempo 80
\track ("Guitar" "Gtr.") { instrument acousticguitarsteel }
\staff { score tabs }
\ts (4 4)
:4 3.5{lf 4} 0.4 2.4{lf 3} 3.4{lf 4} | :2 0.3 2.4{lf 3} |
:4 2.3{lf 3} 0.3 3.4{lf 4} 2.4{lf 3} | :1 0.4 |
:4 2.4{lf 3} 3.4{lf 4} 0.3 2.3{lf 3} | :4 0.3 2.4{lf 3} :2 3.5{lf 4} |
:4 0.4 2.4{lf 3} 0.4 2.5{lf 3} | :1 3.5{lf 4}
