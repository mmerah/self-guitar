// Self-accompanied modal phrase: the i-IV vamp of D Dorian (Dm7 x-x-0-2-1-1, G 3-2-0-0-0-x with
// string 1 left out) on beat 1, a D Dorian line after it. B (the major 6th of D) is the
// note that makes it Dorian rather than natural minor (which would have Bb); bar 1 leans on it
// over Dm7 before landing on F.
\title "A Dorian phrase over Dm7 and G"
\tempo 80
\track ("Guitar" "Gtr.") { instrument acousticguitarsteel }
\staff { tabs }
\ts (4 4)
:4 (0.4 2.3{lf 3} 1.2{lf 2} 1.1{lf 2}){ch "Dm7"} :8 3.2{lf 4} 0.1 :4 0.2 1.1{lf 2} |
:4 (3.6{lf 3} 2.5{lf 2} 0.4 0.3 0.2){ch "G"} :8 0.1 3.2{lf 4} 0.2 1.2{lf 2} :4 0.2 |
:4 (0.4 2.3 1.2 1.1){ch "Dm7"} :8 5.1{lf 5} 3.1{lf 4} 1.1{lf 2} 0.1 :4 3.2{lf 4} |
:4 (3.6 2.5 0.4 0.3 0.2){ch "G"} :8 0.2 1.2{lf 2} 3.2{lf 4} 0.1 :4 (0.4 3.2)
