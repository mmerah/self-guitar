:8 (3.5 1.2){ch "C"} 0.3 (x.6 x.5 x.4){s} 1.2 3.5 0.3 (x.6 x.5 x.4){s} 0.3{p} |
:8 (3.6 0.2){ch "G"} 0.3 (x.6 x.5 x.4){s} 0.2 3.6 0.3 (x.6 x.5 x.4){s} 0.3{p} |
