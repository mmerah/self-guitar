// Two-string boogie over the 12-bar form, swung eighths. E: open 6 + string 5 at fret 2 (E5) / 4 (E6).
// A: open 5 + string 4 at fret 2 / 4. B7 bars stay in the B7 shape: B + D sharp, then B + A.
\title "Boogie shuffle in E, 12 bars"
\tempo 80
\track ("Guitar" "Gtr.") { instrument acousticguitarsteel }
\staff { tabs }
