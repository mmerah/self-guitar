// Monotonic thumb: the open low E on every beat, the fingers add notes on top. Bar 1 walks down
// E minor pentatonic (E D B A G); bar 2 is the E chord: G#, B, E, B.
\title "Monotonic thumb in E"
\tempo 80
\track ("Guitar" "Gtr.") { instrument acousticguitarsteel }
\staff { tabs }
\ts (4 4)
:4 (0.6 0.1){ch "E"} (0.6 3.2{lf 4}) :8 (0.6 0.2) 2.3{lf 3} :4 (0.6 0.3) |
:4 (0.6 1.3{lf 2}) (0.6 0.2) (0.6 0.1) (0.6 0.2)
