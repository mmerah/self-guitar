// Rhythm only, on the open D string: quarters and 8ths | dotted quarters | a syncopated push |
// rests, an 8th-note triplet and a half note.
\title "Rhythm reading: dots, pushes, triplets"
\tempo 90
\track ("Guitar" "Gtr.") { instrument acousticguitarsteel }
