// One G major chord in three CAGED shapes: the G shape (open G, 3-2-0-0-0-3), the E shape barred at
// fret 3 (3-5-5-4-3-3) and the D shape from fret 5 (x-x-5-7-8-7), then back to the E shape.
// lf 2 = index (1), lf 3 = middle (2), lf 4 = ring (3), lf 5 = pinky (4).
\title "G in the G, E and D shapes"
\tempo 80
\track ("Guitar" "Gtr.") { instrument acousticguitarsteel }
\staff { tabs }
\ts (4 4)
:8 3.6{lf 3 txt "G shape"} 2.5{lf 2} 0.4 0.3 0.2 3.1{lf 4} 0.2 0.3 |
3.6{lf 2 txt "E shape"} 5.5{lf 4} 5.4{lf 5} 4.3{lf 3} 3.2{lf 2} 3.1{lf 2} 3.2 4.3 |
5.4{lf 2 txt "D shape"} 7.3{lf 3} 8.2{lf 5} 7.1{lf 4} 8.2 7.3 5.4 7.3 |
3.6{lf 2 txt "E shape"} 5.5{lf 4} 5.4{lf 5} 4.3{lf 3} 3.2{lf 2} 3.1{lf 2} 3.2 4.3
