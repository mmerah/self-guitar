// Open D (string 4) is the drone on every beat; the line above uses strings 1-3.
// D Dorian: D E F G A B C (b3 = F, string 1 fret 1). D Mixolydian: D E F# G A B C (3 = F#, fret 2).
// Same line twice: D E F G F E D C | B C D E F E D, then with F#.
\title "D Dorian and D Mixolydian over a drone"
\tempo 80
\track ("Guitar" "Gtr.") { instrument acousticguitarsteel }
\staff { tabs }
\ts (4 4)
\section "Dorian"
:8 (0.4 3.2{lf 4}) 0.1 (0.4 1.1{lf 2}) 3.1{lf 5} (0.4 1.1) 0.1 (0.4 3.2) 1.2{lf 2} |
:8 (0.4 0.2) 1.2 (0.4 3.2) 0.1 (0.4 1.1) 0.1 :4 (0.4 3.2) |
\section "Mixolydian"
:8 (0.4 3.2{lf 4}) 0.1 (0.4 2.1{lf 3}) 3.1{lf 5} (0.4 2.1) 0.1 (0.4 3.2) 1.2{lf 2} |
:8 (0.4 0.2) 1.2 (0.4 3.2) 0.1 (0.4 2.1) 0.1 :4 (0.4 3.2)
