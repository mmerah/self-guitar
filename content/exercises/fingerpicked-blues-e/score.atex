// 12-bar blues in E, fingerpicked with a monotonic thumb: open E, open A or B (string 5, fret 2) on
// every beat. E bars alternate the two bars of the thumb drill; A7 and B7 keep their chord shapes.
\title "Fingerpicked 12-bar blues in E"
\tempo 80
\track ("Guitar" "Gtr.") { instrument acousticguitarsteel }
\staff { tabs }
\ts (4 4)
