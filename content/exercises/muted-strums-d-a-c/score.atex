// D | A | C: strum only the chord's strings while the thumb damps the unused bass strings.
// E: strum on each beat and choke it on the "and" (release the fretting fingers, keep them touching).
\title "Muted bass strings and chokes"
\tempo 70
\track ("Guitar" "Gtr.") { instrument acousticguitarsteel }
\staff { tabs }
