// Boogie shuffle in A, swung 8ths, 12 bars: A bars on strings 5 + 4, D bars on 4 + 3, E bars on 6 + 5
// (index at fret 2, ring at 4). Bar 11 is the turnaround: G, F#, F, E on string 4 over the open A,
// landing on E7 in bar 12.
\title "Shuffle in A with a turnaround"
\tempo 90
\track ("Guitar" "Gtr.") { instrument acousticguitarsteel }
\staff { tabs }
\ts (4 4) \tf t8
:8 (0.5 2.4{lf 2}){ch "A"} (0.5 2.4) (0.5 4.4{lf 4}) (0.5 4.4) (0.5 2.4) (0.5 2.4) (0.5 4.4) (0.5 4.4) |
