// The House of the Rising Sun - traditional American folk song.
// Accompaniment: p-i-m-a-m-i arpeggio in 6/8, one chord per bar: the thumb plays the bass
// (string 5 for Am and C, 4 for D and F, 6 for E), then i-m-a-m-i on strings 3-2-1-2-3.
// Mini-F (4 strings) for beginners.
\title "The House of the Rising Sun"
\music "Traditional"
\tempo 68
\track ("Guitar" "Gtr.") { instrument acousticguitarsteel }
\staff { score tabs }
\ts (6 8)
